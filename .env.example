DISCORD_TOKEN=replace-with-your-bot-token
LOG_LEVEL=INFO
LLM_BASE_URL=http://host.docker.internal:20128/v1/chat/completions
LLM_MODEL=oc/deepseek-v4-flash-free(max)
# Allow time for routed models to queue and answer concurrent summary requests.
LLM_TIMEOUT=120
# Set this if 9router requires an API key for the chat completions endpoint.
LLM_API_KEY=
IEEE_API_KEY=replace-with-your-ieee-api-key
# Optional current browser Cookie header for institution-authenticated IEEE PDFs.
# This expires and should not be committed.
IEEE_PDF_COOKIE=
# Browser used for IEEE PDFs: obscura (default, attaches over CDP and falls back
# to bundled Chromium if unreachable) or chromium (always launch Chromium).
BROWSER_BACKEND=obscura
# Compose sets OBSCURA_CDP_URL=ws://obscura:9222; the default is ws://127.0.0.1:9222.
# Required by the obscura service. Generate with: openssl rand -hex 32
OBSCURA_CDP_TOKEN=
ELSEVIER_API_KEY=replace-with-your-elsevier-api-key
